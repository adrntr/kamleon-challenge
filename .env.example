# Copy to .env to run Alembic, the API or the tests from the host.
# Host port where docker compose publishes Postgres.
DB_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://kamleon:kamleon@localhost:5432/kamleon
# Created by the tests if missing. The name must end in _test: tests truncate tables.
TEST_DATABASE_URL=postgresql+psycopg://kamleon:kamleon@localhost:5432/kamleon_test
